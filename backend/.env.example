DATABASE_URL="postgresql://cafeteria:cambia_esta_clave@localhost:5432/cafeteria_db?schema=public"

# Credenciales del usuario administrador que crea `npm run db:seed`.
# La contrasena debe tener al menos 12 caracteres.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Firma de los tokens de acceso (HS256). Minimo 32 caracteres.
# Genera una con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Validez del token de acceso: 8h, 30m, 45s o segundos sueltos.
JWT_EXPIRES_IN=8h

# Confianza en X-Forwarded-For para calcular la IP del cliente (limite de
# intentos de login). Desactivado por defecto. Activar solo detras de un proxy
# inverso propio. Acepta: false/off/0, true/on, un numero de saltos, o una
# lista de subredes ("loopback", "10.0.0.0/8").
TRUST_PROXY=false
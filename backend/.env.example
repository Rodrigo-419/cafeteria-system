DATABASE_URL="postgresql://cafeteria:cambia_esta_clave@localhost:5432/cafeteria_db?schema=public"

# Credenciales del usuario administrador que crea `npm run db:seed`.
# El nombre de usuario admite letras minusculas, digitos, punto, guion y guion
# bajo (3 a 30 caracteres). La contrasena debe tener al menos 12 caracteres.
SEED_ADMIN_USUARIO=admin
SEED_ADMIN_PASSWORD=

# Contrasena compartida por los usuarios del seed de DEMOSTRACION
# (`npm run db:seed:demo`). Solo para desarrollo local: debe tener al menos 12
# caracteres y no se muestran valores en los mensajes de error. No la definas en
# produccion; el seed de demostracion se niega a ejecutarse con NODE_ENV=production.
SEED_DEMO_PASSWORD=

# Firma de los tokens de acceso (HS256). Minimo 32 caracteres.
# Genera una con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Validez del token de acceso: 8h, 30m, 45s o segundos sueltos.
JWT_EXPIRES_IN=8h

# Confianza en X-Forwarded-For para calcular la IP del cliente (limite de
# intentos de login). Desactivado por defecto. Activar solo detras de un proxy
# inverso propio. Acepta: false/off/0, true/on, un numero de saltos, o una
# lista de subredes ("loopback", "10.0.0.0/8").
TRUST_PROXY=false

# Origenes autorizados a consumir la API desde un navegador, separados por
# comas. Vacio por defecto: sin esta variable no se permite ningun origen.
# Ejemplo en desarrollo: http://localhost:5173,http://localhost:4173
CORS_ORIGIN=